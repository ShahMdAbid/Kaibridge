{
  "schema": 3,

  "meta": {
    "design_id": "usb_ldo_esp32",
    "title": "ESP32 sensor node",
    "rev": "A2",
    "company": "Kaibridge",
    "date": "2026-08-06",
    "notes": "5V USB in -> AMS1117-3.3 -> ESP32. design_id seeds every UUID: never change it for an existing board."
  },

  "board": {
    "layers": 4,
    "stackup": ["F.Cu (signal)", "In1.Cu (GND)", "In2.Cu (+3V3)", "B.Cu (signal)"],
    "thickness_mm": 1.6,
    "copper_finish": "HASL"
  },

  "netclasses": {
    "Default":  { "track_width": 0.25, "clearance": 0.2,  "via_diameter": 0.6, "via_drill": 0.3 },
    "Power":    { "track_width": 0.6,  "clearance": 0.25, "via_diameter": 0.8, "via_drill": 0.4 },
    "USB_DIFF": { "track_width": 0.25, "clearance": 0.2,  "diff_pair_width": 0.25, "diff_pair_gap": 0.2 }
  },

  "sheets": [
    {
      "id": "power",
      "title": "Power input and 3V3 rail",
      "groups": ["usb_in", "regulator"]
    },
    {
      "id": "mcu",
      "title": "ESP32-WROOM-32 core",
      "groups": ["mcu_core", "straps"]
    }
  ],

  "groups": [
    { "id": "usb_in",    "title": "1. USB 5V input", "parts": ["J1", "D1", "C1"] },
    { "id": "regulator", "title": "2. AMS1117-3.3",   "parts": ["U1", "C2"] },
    { "id": "mcu_core",  "title": "3. MCU",           "parts": ["U2"] },
    { "id": "straps",    "title": "4. Boot straps",   "parts": ["R1", "R2", "SW1"] }
  ],

  "parts": {
    "J1": { "lib_id": "Connector:USB_B_Micro", "value": "USB micro-B",
            "footprint": "kaibridge:USB-MICRO", "group": "usb_in" },
    "D1": { "lib_id": "Device:D_Schottky", "value": "SS34",
            "footprint": "kaibridge:SMA", "group": "usb_in",
            "fields": { "LCSC": "C8678" } },
    "C1": { "lib_id": "Device:C", "value": "10uF",
            "footprint": "Capacitor_SMD:C_0805_2012Metric", "group": "usb_in" },

    "U1": { "lib_id": "kaibridge:AMS1117-3.3", "value": "AMS1117-3.3",
            "footprint": "kaibridge:SOT-223-3_L6.5-W3.4-P2.30-LS7.0-BR", "group": "regulator",
            "fields": { "LCSC": "C6186" } },
    "C2": { "lib_id": "Device:C", "value": "10uF",
            "footprint": "Capacitor_SMD:C_0805_2012Metric", "group": "regulator",
            "near": "U1.2" },

    "U2": { "lib_id": "kaibridge:ESP32-WROOM-32", "value": "ESP32-WROOM-32",
            "footprint": "kaibridge:ESP32-WROOM-32", "group": "mcu_core",
            "fields": { "LCSC": "C701341" }, "dnp": false },

    "R1": { "lib_id": "Device:R", "value": "10k",
            "footprint": "Resistor_SMD:R_0603_1608Metric", "group": "straps",
            "near": "U2.EN" },
    "R2": { "lib_id": "Device:R", "value": "10k",
            "footprint": "Resistor_SMD:R_0603_1608Metric", "group": "straps",
            "near": "U2.25" },
    "SW1": { "lib_id": "Switch:SW_Push", "value": "BOOT",
             "footprint": "kaibridge:SW-SMD_4P", "group": "straps",
             "in_bom": true, "on_board": true, "dnp": false }
  },

  "decoupling": [
    {
      "ic": "U2",
      "value": "100nF",
      "lib_id": "Device:C",
      "footprint": "Capacitor_SMD:C_0603_1608Metric",
      "gnd": "GND"
    },
    {
      "ic": "U1",
      "pins": ["2"],
      "value": "100nF",
      "lib_id": "Device:C",
      "footprint": "Capacitor_SMD:C_0603_1608Metric",
      "gnd": "GND"
    }
  ],

  "nets": {
    "GND":     { "class": "Power", "connections": ["J1.GND", "C1.2", "U1.1", "U2.1", "R2.2", "SW1.2"] },
    "VBUS":    { "class": "Power", "connections": ["J1.VBUS", "D1.2"] },
    "VIN":     { "class": "Power", "connections": ["D1.1", "C1.1", "U1.3"] },
    "+3V3":    { "class": "Power", "connections": ["U1.2", "U1.4", "C2.1", "U2.2", "R1.1"] },
    "EN":      { "connections": ["U2.3", "R1.2"] },
    "IO0":     { "connections": ["U2.25", "R2.1", "SW1.1"] }
  },

  "power_flags": ["GND", "VBUS", "VIN"],

  "no_connect": ["J1.SHIELD", "U2.38"],

  "checks": {
    "unused_pins": "warn",
    "allow_single_pin_nets": false,
    "require_footprints": true
  }
}
