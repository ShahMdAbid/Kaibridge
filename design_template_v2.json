{
  "schema": 2,

  "meta": {
    "design_id": "usb_ldo_esp32",
    "title": "ESP32 sensor node",
    "rev": "A1",
    "company": "abIDE",
    "date": "2026-08-05",
    "notes": "5V USB in -> AMS1117-3.3 -> ESP32"
  },

  "board": {
    "layers": 4,
    "stackup": ["F.Cu (signal)", "In1.Cu (GND)", "In2.Cu (+3V3)", "B.Cu (signal)"],
    "thickness_mm": 1.6,
    "copper_finish": "HASL"
  },

  "netclasses": {
    "Default":  { "track_width": 0.25, "clearance": 0.2, "via_diameter": 0.6, "via_drill": 0.3 },
    "Power":    { "track_width": 0.6,  "clearance": 0.25, "via_diameter": 0.8, "via_drill": 0.4 },
    "USB_DIFF": { "track_width": 0.25, "clearance": 0.2, "diff_pair_width": 0.25, "diff_pair_gap": 0.2 }
  },

  "groups": [
    { "id": "power_in",   "title": "1. Power input (USB 5V)", "parts": ["J1", "D1", "C1"] },
    { "id": "regulator",  "title": "2. 3V3 LDO",              "parts": ["U1", "C2", "C3"] },
    { "id": "mcu",        "title": "3. MCU",                   "parts": ["U2", "C4", "R1", "R2"] }
  ],

  "parts": {
    "J1": { "lib_id": "Connector:USB_B_Micro", "value": "USB micro-B", "footprint": "abide:USB-MICRO", "group": "power_in" },
    "D1": { "lib_id": "Device:D_Schottky", "value": "SS34", "footprint": "abide:SMA", "group": "power_in",
            "fields": { "LCSC": "C8678" } },
    "C1": { "lib_id": "Device:C", "value": "10uF", "footprint": "Capacitor_SMD:C_0805_2012Metric", "group": "power_in" },

    "U1": { "lib_id": "abide:AMS1117-3.3", "value": "AMS1117-3.3",
            "footprint": "abide:SOT-223-3_L6.5-W3.4-P2.30-LS7.0-BR", "group": "regulator",
            "fields": { "LCSC": "C6186" } },
    "C2": { "lib_id": "Device:C", "value": "10uF", "footprint": "Capacitor_SMD:C_0805_2012Metric", "group": "regulator" },
    "C3": { "lib_id": "Device:C", "value": "100nF", "footprint": "Capacitor_SMD:C_0603_1608Metric", "group": "regulator" },

    "U2": { "lib_id": "abide:ESP32-WROOM-32", "value": "ESP32-WROOM-32", "footprint": "abide:ESP32-WROOM-32",
            "group": "mcu", "fields": { "LCSC": "C701341" }, "dnp": false },
    "C4": { "lib_id": "Device:C", "value": "100nF", "footprint": "Capacitor_SMD:C_0603_1608Metric", "group": "mcu" },
    "R1": { "lib_id": "Device:R", "value": "10k", "footprint": "Resistor_SMD:R_0603_1608Metric", "group": "mcu" },
    "R2": { "lib_id": "Device:R", "value": "10k", "footprint": "Resistor_SMD:R_0603_1608Metric", "group": "mcu" }
  },

  "nets": {
    "GND":   { "class": "Power", "style": "global", "connections": ["J1.GND", "D1.1", "C1.2", "U1.1", "C2.2", "C3.2", "U2.1", "C4.2", "R2.2"] },
    "VBUS":  { "class": "Power", "connections": ["J1.VBUS", "D1.2"] },
    "VIN":   { "class": "Power", "connections": ["D1.1", "C1.1", "U1.3"] },
    "+3V3":  { "class": "Power", "style": "global", "connections": ["U1.2", "U1.4", "C2.1", "C3.1", "U2.2", "C4.1", "R1.1"] },
    "EN":    { "connections": ["U2.3", "R1.2", "C4.1"] },
    "IO0":   { "connections": ["U2.25", "R2.1"] }
  },

  "power_flags": ["GND", "+3V3", "VIN"],

  "no_connect": ["J1.SHIELD", "U2.38"],

  "checks": {
    "unused_pins": "warn",
    "allow_single_pin_nets": false,
    "require_footprints": true
  }
}
